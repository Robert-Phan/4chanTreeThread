{
  "manifest_version": 3,
  "name": "Tree-Style 4chan Threads",
  "version": "0.0.1",
  "description": "Turns a 4chan thread into a tree format.",
  "page_action": {
    "default_title": "Turn into Tree",
    "show_matches": ["*://boards.4chan.org/*/thread/*"]
  },
  "background": {
    "scripts": ["dist/background.js"]
  },
  "permissions": ["tabs"],
  "host_permissions": ["*://boards.4chan.org/*/thread/*"],
  "content_scripts": [
    {
      "matches": ["*://boards.4chan.org/*/thread/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "4chantree@example.local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}